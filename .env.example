# Public Supabase values only. Never put service-role keys or Font Awesome tokens here.
# Local values come from: npx supabase status -o env
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Font Awesome Package Token is NOT a VITE_ variable and must NOT live in this file.
# Export it in your shell / ~/.config/fontawesome/env, and as GitHub Actions secret
# FONTAWESOME_PACKAGE_TOKEN. See README.md → Font Awesome Pro.
#
# Local RLS provisioning/tests (shell only — never VITE_, never commit):
#   export LOCAL_TEST_PASSWORD='choose-a-local-only-password-12+'
# See docs/SUPABASE_LOCAL.md.
