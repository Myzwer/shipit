# Public Supabase values only (Phase 1+). Never put service-role keys or Font Awesome tokens here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Font Awesome Package Token is NOT a VITE_ variable and must NOT live in this file.
# Export it in your shell / ~/.config/fontawesome/env, and as GitHub Actions secret
# FONTAWESOME_PACKAGE_TOKEN. See README.md → Font Awesome Pro.
